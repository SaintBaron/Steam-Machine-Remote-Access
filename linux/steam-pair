#!/usr/bin/env python3
"""steam-pair: set Sunshine's web UI login and pair Moonlight, from the terminal.
https://github.com/SaintBaron/Steam-Machine-Remote-Access

Run `steam-connect nostream` in another window first: it starts Sunshine and
opens the tunnel this talks through (https://localhost:47990 by default).

Usage:
  steam-pair login     create the web UI login (or change it)
  steam-pair           pair Moonlight with Sunshine
"""
import base64
import getpass
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request

VERSION = "1.2.0"
WAIT_FOR_MOONLIGHT = 120  # seconds to wait for you to click the host in Moonlight

# Sunshine uses a self-signed certificate. The connection only reaches this PC's end
# of the SSH tunnel, which is already encrypted and authenticated, so it isn't checked.
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE


def say(msg):
    print(f"\033[1;34m==>\033[0m {msg}")


def die(msg):
    print(f"\033[1;31mError:\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def load_config():
    conf = {"WEBUI_PORT": "47990", "MACHINE_IP": "", "CLIENT_NAME": "", "HOST_ALIAS": "steam-machine"}
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "steam-remote", "config")
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r'^([A-Z_]+)=(?:"([^"]*)"|([^\s#"]*))\s*(?:#.*)?$', line.rstrip("\n"))
                if m and m.group(1) in conf:
                    conf[m.group(1)] = m.group(2) if m.group(2) is not None else m.group(3)
    except FileNotFoundError:
        die(f"No config at {path}. Run: steam-remote-setup")
    if not conf["WEBUI_PORT"].isdigit():
        die("WEBUI_PORT in the config must be a number")
    conf["CLIENT_NAME"] = conf["CLIENT_NAME"] or socket.gethostname() or "linux-pc"
    return conf


CONF = load_config()
URL = f"https://localhost:{CONF['WEBUI_PORT']}"


def check_tunnel():
    """Only send the web UI password into steam-connect's own SSH tunnel. Anything
    else listening on that local port (another user's program, say) would see it."""
    alias = CONF["HOST_ALIAS"]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", alias):
        die("HOST_ALIAS in the config is invalid")
    ctl = os.path.expanduser(f"~/.ssh/cm-{alias}")
    up = subprocess.run(["ssh", "-S", ctl, "-O", "check", alias],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not up:
        die("steam-connect isn't connected. Run `steam-connect nostream` in another window first.")
    port = CONF["WEBUI_PORT"]
    held_by_other = f"Port {port} is held by another program, not the SSH tunnel. Not sending the password."
    try:  # Linux
        out = subprocess.run(["ss", "-Hltnp", f"sport = :{port}"],
                             capture_output=True, text=True, timeout=5).stdout
        if out.strip() and '"ssh"' not in out:
            die(held_by_other)
        return
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:  # macOS: lsof only lists this user's programs, so a listener it can't see is someone else's
        out = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fc"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return  # neither tool available: the login check above will have to do
    if "cssh" in out.split():
        return
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=2):
            pass
    except OSError:
        return  # nothing listening; the request will simply fail
    die(held_by_other)


def call(method, path, auth=None, body=None, timeout=10):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, method=method)
    if auth:
        req.add_header("Authorization", "Basic " + auth)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, context=CTX, timeout=timeout) as resp:
        raw = resp.read()
    return json.loads(raw) if raw else {}


def b64(user, password):
    return base64.b64encode(f"{user}:{password}".encode()).decode()


def unreachable(e):
    die(f"Can't reach Sunshine at {URL} ({e}). Run `steam-connect nostream` in another window first.")


def new_password():
    while True:
        p1 = getpass.getpass("New web UI password: ")
        if len(p1) < 8:
            print("Use at least 8 characters.")
            continue
        if p1 != getpass.getpass("Same password again: "):
            print("They didn't match. Try again.")
            continue
        return p1


def set_login():
    user = input("Web UI username [sunshine]: ").strip() or "sunshine"
    password = new_password()
    body = {"newUsername": user, "newPassword": password, "confirmNewPassword": password}
    try:
        result = call("POST", "/api/password", body=body)   # first time: no login exists yet
    except urllib.error.HTTPError as e:
        if e.code != 401:
            die(f"Sunshine answered with HTTP {e.code}: {e.read().decode(errors='replace')}")
        say("A web UI login already exists. To change it, enter the current one.")
        cur_user = input("Current username [sunshine]: ").strip() or "sunshine"
        cur_pass = getpass.getpass("Current password: ")
        body.update({"currentUsername": cur_user, "currentPassword": cur_pass})
        try:
            result = call("POST", "/api/password", auth=b64(cur_user, cur_pass), body=body)
        except urllib.error.HTTPError as e2:
            die("Wrong current username or password." if e2.code == 401 else f"HTTP {e2.code}")
    except (urllib.error.URLError, OSError) as e:
        unreachable(e)
    if result.get("status") is True:
        say(f"Web UI login set. Username: {user}")
    else:
        die(f"Sunshine didn't accept it: {result}")


def pending(auth):
    return call("GET", "/api/pin", auth).get("pairings", [])


def pair():
    user = input("Web UI username [sunshine]: ").strip() or "sunshine"
    auth = b64(user, getpass.getpass("Web UI password: "))
    try:
        waiting = pending(auth)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("Wrong username or password (no login yet? run: steam-pair login).")
        die(f"Sunshine answered with HTTP {e.code}: {e.read().decode(errors='replace')}")
    except (urllib.error.URLError, OSError) as e:
        unreachable(e)
    say("Logged in to Sunshine")

    if not waiting:
        host = CONF["MACHINE_IP"] or "the Steam Machine's IP"
        say(f"In Moonlight, add {host} with the + button if it isn't listed, then click it.")
        say("Moonlight shows a 4-digit PIN. Leave that dialog open.")
        deadline = time.monotonic() + WAIT_FOR_MOONLIGHT
        while not waiting and time.monotonic() < deadline:
            time.sleep(2)
            print(".", end="", flush=True)
            waiting = pending(auth)
        print()
        if not waiting:
            die("No pairing request arrived within 2 minutes. Click the host in Moonlight, then run steam-pair again.")

    if len(waiting) == 1:
        request = waiting[0]
    else:
        say("More than one pairing request is waiting:")
        for i, p in enumerate(waiting, 1):
            print(f"  {i}. {p.get('name') or 'unnamed'} from {p.get('address', '?')}")
        choice = input("Which one? [1]: ").strip() or "1"
        if not choice.isdigit() or not 1 <= int(choice) <= len(waiting):
            die("Not a valid choice.")
        request = waiting[int(choice) - 1]
    say(f"Pairing request from {request.get('address', '?')}")

    pin = input("PIN shown in Moonlight: ").strip()
    if not (len(pin) == 4 and pin.isdigit()):
        die("The PIN must be exactly 4 digits.")
    say("Pairing...")
    try:
        result = call("POST", "/api/pin", auth,
                      {"pairing_id": request["id"], "pin": pin, "name": CONF["CLIENT_NAME"]}, timeout=60)
    except urllib.error.HTTPError as e:
        die(f"Sunshine rejected it (HTTP {e.code}): {e.read().decode(errors='replace')}")
    except (urllib.error.URLError, OSError) as e:
        die(f"Lost the connection to Sunshine ({e}).")
    if result.get("status") is True:
        say(f"Paired as '{CONF['CLIENT_NAME']}'. Moonlight should now unlock the host.")
    else:
        die("Pairing failed: wrong PIN, or Moonlight timed out. Click the host again and rerun steam-pair.")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("login", ""):
        check_tunnel()
    if arg in ("-h", "--help"):
        print(__doc__.strip())
    elif arg == "--version":
        print(f"steam-pair {VERSION}")
    elif arg == "login":
        set_login()
    elif arg == "":
        pair()
    else:
        die(f"Unknown option '{arg}'. Try: steam-pair --help")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
